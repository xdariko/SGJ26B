  m_text: "\u0420\u0430\u0431\u043E\u0447\u0435\u0435 \u043C\u0435\u0441\u0442\u043E
    \u0441\u043A\u0440\u043E\u043C\u043D\u043E\u0435: \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u0439
    \u0441\u0442\u043E\u043B, \u043E\u0441\u0442\u044B\u0432\u0448\u0438\u0439 \u0447\u0430\u0439
    \u0438 \u043E\u0434\u043D\u0430 \u0441\u0442\u0430\u0440\u0430\u044F \u043A\u0430\u043C\u0435\u0440\u0430.\n\n\u041D\u0430
    \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u0435 \u0437\u0430\u043F\u0438\u0441\u043A\u0430:
    \n\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u043C\u043E\u0436\u043D\u043E
    \u043A\u0443\u043F\u0438\u0442\u044C. \u0417\u0430 \u0441\u0432\u043E\u0439 \u0441\u0447\u0451\u0442,
    \u0440\u0430\u0437\u0443\u043C\u0435\u0435\u0442\u0441\u044F. \u041C\u044B \u0446\u0435\u043D\u0438\u043C
    \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0443."
