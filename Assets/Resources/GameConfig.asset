  rootNodeId: night_shift
  shiftDuration: 90
  nightNotes:
  - night: 1
    text: "\u041A\u043B\u0438\u043A\u0430\u0439 \u043F\u043E \u043C\u0443\u0441\u043E\u0440\u0443,
      \u0447\u0442\u043E\u0431\u044B \u0441\u043D\u044F\u0442\u044C \u0435\u0433\u043E
      \u0441 \u043B\u0435\u043D\u0442\u044B.\n\u0412\u0441\u0451 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u043F\u0443\u0441\u0442\u044C \u0435\u0434\u0435\u0442 \u043A \u0430\u0434\u0440\u0435\u0441\u0430\u0442\u0430\u043C."
  - night: 2
    text: "\u041F\u043E\u0447\u0442\u044B \u0432\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435.
      \u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u043F\u0435\u0447\u0430\u0442\u044F\u043C\u0438
      \u0430\u0434\u0440\u0435\u0441\u0430\u0442\u043E\u0432."
  - night: 3
    text: "\u0425\u043E\u0434\u044F\u0442 \u0441\u043B\u0443\u0445\u0438 \u043E \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u0445
      \u043F\u043E\u0441\u044B\u043B\u043A\u0430\u0445..."
  - night: 5
    text: "\u0412 \u043F\u043E\u0441\u044B\u043B\u043A\u0430\u0445 \u0437\u0430\u0432\u0435\u043B\u0438\u0441\u044C
      \u043C\u0438\u043C\u0438\u043A\u0438.\n\u0410 \u0438\u0437\u043D\u0443\u0442\u0440\u0438
      \u043A\u0442\u043E-\u0442\u043E \u0448\u0435\u043F\u0447\u0435\u0442."
