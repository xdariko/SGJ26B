      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435.\n\u0421 \u043A\u0430\u0436\u0434\u044B\u043C
      \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u0435\u0449\u0451 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435.||\u0421\u043B\u043E\u043C\u0430\u043D\u043D\u0430\u044F
      \u043B\u0435\u043D\u0442\u0430 \u0435\u0434\u0435\u0442 \u043D\u0430 <color=#FFE08A>50%</color>
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435.\n\u0415\u0449\u0451
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u2014 \u0438 \u043E\u043D\u0430
      \u0432\u0441\u0442\u0430\u043D\u0435\u0442.||\u0421\u043B\u043E\u043C\u0430\u043D\u043D\u0430\u044F
      \u043B\u0435\u043D\u0442\u0430 \u0435\u0434\u0435\u0442 \u043D\u0430 <color=#FFE08A>75%</color>
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435.\n\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0435\u0451 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442.||\u041F\u043E\u043A\u0430
