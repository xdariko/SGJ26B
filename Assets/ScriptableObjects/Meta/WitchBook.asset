    title: "\u041D\u043E\u0447\u043D\u0430\u044F \u0441\u043C\u0435\u043D\u0430"
    description: "\u0422\u044B \u043D\u043E\u0447\u043D\u043E\u0439 \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0449\u0438\u043A
      <color=#FFE08A>\u0422\u044B\u043A\u0432\u0435\u043D\u043D\u043E\u0439 \u043F\u043E\u0447\u0442\u044B</color>.\n\u041E\u0442\u0441\u044E\u0434\u0430
      \u0440\u0430\u0441\u0442\u0451\u0442 \u0432\u0441\u0451 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435."
    gridPosition: {x: 0, y: 0}
    icon: {fileID: 21300000, guid: 2e711caff84bb4644aaf36557b5134b6, type: 3}
    iconColor: {r: 1, g: 1, b: 1, a: 1}
    previousNodeIds: []
    maxLevel: 1
    costs: []
    effects: []
  - id: cam_carve
    title: "\u0420\u043E\u0432\u043D\u0430\u044F \u0440\u0435\u0437\u044C\u0431\u0430"
    description: "\u041A\u0430\u043C\u0435\u0440\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u0435\u0442
      <color=#FFE08A>\u043C\u0430\u0440\u043A\u0438</color>.\n\u041B\u0438\u043D\u0438\u044F
      1 \u0441\u0442\u0430\u043D\u0435\u0442 \xAB\u0412\u0430\u043C\u043F\u0438\u0440\u0430\u043C\xBB:
      \u0447\u0443\u0436\u0438\u0435 \u043C\u0430\u0440\u043A\u0438 \u0441\u043D\u0438\u043C\u0430\u0439,
      <color=#FFE08A>+2 \u043C\u043E\u043D\u0435\u0442\u044B</color> \u0437\u0430
      \u043A\u0430\u0436\u0434\u0443\u044E."
    gridPosition: {x: 0, y: 1}
    icon: {fileID: 21300000, guid: c9028f23673b1654cb28fdbd23a65601, type: 3}
    iconColor: {r: 1, g: 1, b: 1, a: 1}
